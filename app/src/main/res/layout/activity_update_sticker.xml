<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar figurita"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:textAlignment="center"/>

    <ListView
        android:id="@+id/listViewStickers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"/>

    <EditText
        android:id="@+id/etStickerNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número de figurita"
        android:enabled="false"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etNewName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nuevo nombre"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/etNewTeam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nuevo equipo"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar cambios"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:layout_marginTop="12dp"/>

</LinearLayout>



